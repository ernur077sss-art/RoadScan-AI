# Backend container only. Copy to deploy/.env (gitignored) and fill every blank.
# These examples do not provision any services or credentials.
ROADSCAN_ENV=production
PORT=8000
ROADSCAN_ORIGIN=https://your-project.vercel.app
ROADSCAN_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/roadscan?sslmode=require
# Alternatively omit :PASSWORD in the URL and set the raw password here.
# Do not URL-encode this value. Leave empty when the URL already contains it.
ROADSCAN_DATABASE_PASSWORD=
ROADSCAN_DATA_DIR=/app/.data
# Generate once, store in a secret manager, reuse across replicas and backups.
ROADSCAN_SECRET=
ROADSCAN_STORAGE=s3
ROADSCAN_S3_ENDPOINT=
ROADSCAN_S3_BUCKET=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ROADSCAN_AUTH_MODE=password
ROADSCAN_SMS_MODE=development
ROADSCAN_SMS_URL=
ROADSCAN_SMS_TOKEN=
ROADSCAN_109_MODE=disabled
